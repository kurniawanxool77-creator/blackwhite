# Database (SQLite lokal). Produksi: postgresql://user:pass@host:5432/db dan ganti provider di prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, tipe Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Akun untuk mencoba aplikasi (dibuat oleh: npm run db:seed). Ganti sebelum produksi.
# Superadmin login di /superadmin, panitia di /admin.
SUPERADMIN_EMAIL="superadmin@contoh.co.id"
SUPERADMIN_PASSWORD="ganti-password-ini"
PANITIA_EMAIL="panitia@contoh.co.id"
PANITIA_PASSWORD="ganti-password-ini"
# Akun peserta contoh (login email + password di /login). Peserta lain mendaftar sendiri di /daftar atau memakai Google.
PESERTA_EMAIL="peserta@contoh.co.id"
PESERTA_PASSWORD="ganti-password-ini"
