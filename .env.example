# Database PostgreSQL (Supabase Transaction Pooler direkomendasikan untuk Vercel Serverless)
# Port 6543 + ?pgbouncer=true&connection_limit=1 untuk runtime Vercel; gunakan port 5432 bila menjalankan prisma db push.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# URL aplikasi (lokal: http://localhost:5173 ; Vercel: https://domain-anda.vercel.app)
NEXTAUTH_URL="http://localhost:5173"
# Kunci penanda session HMAC (wajib diisi string acak panjang di Vercel)
NEXTAUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, Web application)
# Authorized redirect URI:
# - Lokal: http://localhost:5173/api/auth/callback/google
# - Vercel: https://domain-anda.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Akun awal (untuk `npm run db:seed` dan bootstrap Superadmin pertama). Ganti sebelum produksi.
# Superadmin login di /superadmin, panitia di /admin.
SUPERADMIN_EMAIL="superadmin@contoh.co.id"
SUPERADMIN_PASSWORD="ganti-password-ini"
PANITIA_EMAIL="panitia@contoh.co.id"
PANITIA_PASSWORD="ganti-password-ini"
# Akun peserta contoh (login email + password di /login).
PESERTA_EMAIL="peserta@contoh.co.id"
PESERTA_PASSWORD="ganti-password-ini"
