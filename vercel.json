{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && npx vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/media/:id", "destination": "/api/index?__path=/media/:id" },
    { "source": "/robots.txt", "destination": "/api/index?__path=/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/index?__path=/sitemap.xml" },
    { "source": "/manifest.webmanifest", "destination": "/api/index?__path=/manifest.webmanifest" },
    { "source": "/icon/:size", "destination": "/api/index?__path=/icon/:size" },
    { "source": "/apple-icon", "destination": "/api/index?__path=/apple-icon" },
    { "source": "/superadmin/events/:id/export", "destination": "/api/index?__path=/superadmin/events/:id/export" },
    { "source": "/superadmin/qr/:id", "destination": "/api/index?__path=/superadmin/qr/:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
